# ============================================================
# infra-dissertacao — Variáveis de Ambiente
# Copie este arquivo para .env antes de subir a stack:
#   cp .env.example .env
#
# Estas credenciais são para ambiente LOCAL de desenvolvimento.
# Para produção, gere novas senhas e chaves Fernet.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=dlh_admin
POSTGRES_PASSWORD=dlh_pass_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Databases (criados via infra/postgres/init/01_databases.sql)
POSTGRES_DB_METASTORE=metastore_db
POSTGRES_DB_AIRFLOW=airflow_db
POSTGRES_DB_BASELINE=baseline_db

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_pass_2026
MINIO_ENDPOINT=http://minio:9000

# Buckets (criados automaticamente pelo serviço minio-init)
MINIO_BUCKET_LANDING=landing
MINIO_BUCKET_LAKEHOUSE=lakehouse

# --- Hive Metastore ---
HIVE_METASTORE_PORT=9083

# --- Spark ---

# --- Trino ---
TRINO_PORT=8090

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
# Gere uma nova chave para produção:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLt0nIe3aY=
AIRFLOW__WEBSERVER__SECRET_KEY=dlh_airflow_secret_2026
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://dlh_admin:dlh_pass_2026@postgres:5432/airflow_db
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW_PORT=8080

# --- OpenMetadata ---
OPENMETADATA_PORT=8585
# Email do usuário admin do OM — varia conforme o deploy:
#   "admin@open-metadata.org"  → deploy padrão (casa)
#   "admin@openmetadata.org"   → alguns deploys alternativos (trabalho)
OM_ADMIN_EMAIL=admin@open-metadata.org

# --- OpenMetadata Ingestion (Airflow interno do OpenMetadata) ---
OM_AIRFLOW_DB=airflow_om_db
# Gere uma nova chave para produção (mesma instrução do Airflow acima)
OM_AIRFLOW_FERNET_KEY=6gUQyTNfuph5LGzMWJdmh0jldDCwm8TFcLoYZg8H7zk=

